{
  "name": "listing-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Turn item photos into reviewed eBay listings: upload, review Claude's drafts, approve and publish.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "bcryptjs": "3.0.2",
    "drizzle-orm": "0.45.3",
    "heic-convert": "2.1.0",
    "jose": "6.1.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
