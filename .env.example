# Listing Desk environment variables.
# Copy to .env for local development. On Sevalla, set these under the
# application's Environment variables (runtime, and DATABASE_URL at build time too).
# Never commit real values.

# --- App ---------------------------------------------------------------
# Public URL of the app, no trailing slash. Used for eBay callbacks.
APP_BASE_URL=http://localhost:3000

# Login: a bcrypt hash of your password. Generate with:
#   npm run hash-password -- "your password here"
ADMIN_PASSWORD_HASH=

# Random secret for signing login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# 32-byte key (base64) used to encrypt the stored eBay refresh token.
# Generate the same way as SESSION_SECRET, but use a different value.
ENCRYPTION_KEY=

# --- Database (Sevalla managed Postgres) ---------------------------------
DATABASE_URL=postgresql://user:password@host:5432/listing_desk

# --- Object storage (Sevalla buckets, S3-compatible) ---------------------
# Endpoint, keys and region come from the bucket's "Connect" panel in Sevalla.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for original photos.
S3_BUCKET_ORIGINALS=listing-desk-originals
# Public bucket for resized listing photos (eBay downloads from here).
S3_BUCKET_PUBLIC=listing-desk-photos
# Public base URL of the public bucket, no trailing slash, e.g.
#   https://listing-desk-photos.sevalla.storage
PUBLIC_PHOTO_BASE_URL=

# --- Claude ----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=

# --- eBay ------------------------------------------------------------------
# "mock"       test mode: eBay is simulated, no eBay keys needed (use while
#              waiting for eBay to approve your developer account)
# "sandbox"    eBay's test site
# "production" real listings
EBAY_ENV=sandbox
# The values below are required for sandbox and production, optional for mock.
# From developer.ebay.com > Application Keys (match EBAY_ENV).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (redirect URL name) from User Tokens > "Get a Token from eBay
# via Your Application". Set its "auth accepted URL" to:
#   ${APP_BASE_URL}/api/ebay/callback
EBAY_RUNAME=
EBAY_MARKETPLACE_ID=EBAY_US
# Marketplace Account Deletion: any 32-80 character string you choose,
# entered on eBay's Alerts & Notifications page along with the endpoint
#   ${APP_BASE_URL}/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
